# Copy to .env before starting the stack. Replace every change-me value outside local development.
ARIA_DEBUG=true
# The production readiness Make target injects the current Git commit automatically.
ARIA_RELEASE_REVISION=unknown
ARIA_SECRET_KEY=change-me-with-a-long-random-value
ARIA_ALLOWED_HOSTS=localhost,127.0.0.1,api
# For a Cloudflare Tunnel, add the public hostname to ARIA_ALLOWED_HOSTS and its full HTTPS origin
# here. Trust X-Forwarded-Proto only when the app is reachable exclusively through that proxy.
ARIA_CSRF_TRUSTED_ORIGINS=
ARIA_TRUST_X_FORWARDED_PROTO=false
ARIA_SSL_REDIRECT=false
ARIA_SECURE_COOKIES=false
ARIA_SECURE_HSTS_SECONDS=0
ARIA_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
ARIA_SECURE_HSTS_PRELOAD=false
ARIA_BIND_ADDRESS=127.0.0.1
ARIA_WEB_PORT=8000
ARIA_LOG_LEVEL=INFO
ARIA_WORKER_CONCURRENCY=2
ARIA_ENFORCE_OPERATOR_ROLES=false
ARIA_REQUIRE_SEPARATE_PUBLISHER=false
ARIA_SESSION_COOKIE_AGE_SECONDS=3600
ARIA_LOGIN_RATE_LIMIT_ATTEMPTS=5
ARIA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# Required only for the private /health/metrics/ scrape endpoint and observability profile.
ARIA_METRICS_TOKEN=
ARIA_PROMETHEUS_BIND_ADDRESS=127.0.0.1
ARIA_PROMETHEUS_PORT=9090
ARIA_GRAFANA_ADMIN_USER=aria-observer
ARIA_GRAFANA_ADMIN_PASSWORD=
ARIA_GRAFANA_BIND_ADDRESS=127.0.0.1
ARIA_GRAFANA_PORT=3002
ARIA_GRAFANA_DOMAIN=localhost
ARIA_GRAFANA_ROOT_URL=http://localhost:3002
ARIA_GRAFANA_ENFORCE_DOMAIN=false

POSTGRES_DB=aria
POSTGRES_USER=aria
POSTGRES_PASSWORD=change-me-database-password

REDIS_PASSWORD=change-me-redis-password

# Artifact bytes are self-hosted in a Docker volume by default. Set backend to s3 for Cloudflare R2.
ARIA_OBJECT_STORAGE_BACKEND=filesystem
ARIA_OBJECT_STORAGE_ROOT=/var/lib/aria/artifacts
ARIA_OBJECT_STORAGE_ENDPOINT=
ARIA_OBJECT_STORAGE_BUCKET=aria-artifacts
ARIA_OBJECT_STORAGE_ACCESS_KEY=
ARIA_OBJECT_STORAGE_SECRET_KEY=
ARIA_OBJECT_STORAGE_REGION=auto

# Database backups are always age-encrypted before leaving the container. Keep the private age
# identity offline; only its public age1... recipient belongs here.
ARIA_BACKUP_ROOT=/var/lib/aria/backups
ARIA_BACKUP_AGE_RECIPIENT=
ARIA_BACKUP_UPLOAD_TO_R2=false
ARIA_BACKUP_R2_PREFIX=backups/database

ARIA_HTTP_USER_AGENT=ARIA-Core/0.1 (+https://github.com/aminhaiqal/aria)
ARIA_HTTP_CONNECT_TIMEOUT_SECONDS=10
ARIA_HTTP_READ_TIMEOUT_SECONDS=30
ARIA_HTTP_MAX_RESPONSE_BYTES=26214400
ARIA_HTTP_MAX_REDIRECTS=5
ARIA_HTTP_MIN_DOMAIN_INTERVAL_SECONDS=1
# The Parliament server omits this public Sectigo intermediate from its TLS handshake. ARIA adds
# the reviewed repository certificate to the normal Mozilla roots; TLS verification stays enabled.
ARIA_HTTP_SUPPLEMENTAL_CA_BUNDLE=/app/config/certificates/sectigo-public-server-authentication-ca-dv-r36.pem

# Optional outbound delivery for explicitly published impact reviews. The destination must be an
# allowlisted public HTTPS hostname. Leave URL blank to keep delivery disabled and events pending.
ARIA_IMPACT_WEBHOOK_URL=
ARIA_IMPACT_WEBHOOK_ALLOWED_DOMAINS=
ARIA_IMPACT_WEBHOOK_SECRET=
ARIA_IMPACT_WEBHOOK_MAX_ATTEMPTS=5
ARIA_IMPACT_WEBHOOK_BATCH_SIZE=10
ARIA_IMPACT_WEBHOOK_STALE_MINUTES=15

# Browser retrieval is opt-in per JavaScript endpoint and runs only in browser-worker.
ARIA_BROWSER_PROFILE_NAME=bounded-chromium
ARIA_BROWSER_PROFILE_VERSION=1
ARIA_BROWSER_NAVIGATION_TIMEOUT_SECONDS=30
ARIA_BROWSER_RENDER_WAIT_MILLISECONDS=750
ARIA_BROWSER_MAX_REQUESTS=80
ARIA_BROWSER_MAX_RESPONSE_BYTES=26214400
ARIA_BROWSER_MAX_DOM_BYTES=5242880
ARIA_BROWSER_MAX_CAPTURE_BODY_BYTES=2097152
ARIA_BROWSER_MAX_REQUEST_BODY_BYTES=65536
ARIA_BROWSER_MAX_REDIRECTS=5

ARIA_MONITOR_UNHEALTHY_AFTER_FAILURES=3
ARIA_MONITOR_RESOURCE_BATCH_SIZE=5
ARIA_MONITOR_RESOURCE_BATCH_PER_ENDPOINT=3
ARIA_MONITOR_MAX_ENABLED_RESOURCES_PER_ENDPOINT=50
ARIA_SOURCE_FRESHNESS_GRACE_MINUTES=60
ARIA_SOURCE_PIPELINE_GRACE_MINUTES=30

# The local deterministic projection remains the offline default. OpenAI can be populated in
# parallel and selected after retrieval evaluation without changing the 384-dimensional schema.
ARIA_EMBEDDING_PROVIDER=local_hash
ARIA_LOCAL_EMBEDDING_MODEL=aria-token-hash-v1
ARIA_EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
OPENAI_BASE_URL=
ARIA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ARIA_READER_FRONTEND=react
ARIA_READER_EMBEDDING_PROVIDER=local_hash
ARIA_READER_PAGE_SIZE=10
ARIA_READER_SEARCH_RATE=60/min
ARIA_READER_DOCUMENT_RATE=120/min
ARIA_MONITOR_STRUCTURE_DRIFT_PAUSE_MINUTES=1440
ARIA_OPENAI_EMBEDDING_BATCH_SIZE=64
ARIA_OPENAI_TIMEOUT_SECONDS=60
ARIA_OPENAI_MAX_RETRIES=3
ARIA_OPENAI_SUMMARY_MODEL=gpt-5.6-sol
ARIA_OPENAI_SUMMARY_REASONING_EFFORT=low
ARIA_OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=2000
ARIA_OPENAI_SUMMARY_MAX_ITEMS=50
ARIA_OPENAI_SUMMARY_MAX_CHARS_PER_ANCHOR=12000
ARIA_OPENAI_IMPACT_MODEL=gpt-5.6-sol
ARIA_OPENAI_IMPACT_REASONING_EFFORT=low
ARIA_OPENAI_IMPACT_MAX_OUTPUT_TOKENS=3000
ARIA_OPENAI_IMPACT_MAX_CHARS_PER_ANCHOR=12000
# Automatically summarize only after every deterministic change has a human decision.
# Defaults to true when OPENAI_API_KEY is populated; set false for a manual-only deployment.
ARIA_AUTO_GPT_SUMMARIES=false
ARIA_ORCHESTRATION_STALE_AFTER_MINUTES=30
ARIA_ORCHESTRATION_RECOVERY_BATCH_SIZE=5
ARIA_PDF_OCR_MIN_CHARACTERS_PER_PAGE=40

# Self-hosted OCR profile. Bump the profile version when toolchain or processing options change.
ARIA_OCR_PROFILE_NAME=jpdp-msa-eng
ARIA_OCR_PROFILE_VERSION=1
ARIA_OCR_LANGUAGES=msa+eng
ARIA_OCR_BINARY=ocrmypdf
ARIA_OCR_TESSERACT_BINARY=tesseract
ARIA_OCR_DECLARED_TOOLCHAIN=aria-ocr-bookworm-v1
ARIA_OCR_PROCESS_TIMEOUT_SECONDS=1800
ARIA_OCR_TESSERACT_TIMEOUT_SECONDS=300
ARIA_OCR_MAX_INPUT_BYTES=52428800
ARIA_OCR_STALE_AFTER_MINUTES=45
